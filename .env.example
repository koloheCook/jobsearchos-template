# Copy to .env (already gitignored) and fill in your own values.
# Never commit real values -- .env and .env.* are gitignored except this file.

# Notion internal integration token (Read content only capability, shared with
# ONLY your job tracker database + its companion company-name database).
NOTION_API_KEY=

# Your Notion Master Job Tracker's database ID and data source ID.
# Find these from the tracker's "Copy link" URL in Notion, or via the Notion API.
JOBSEARCHOS_NOTION_DATABASE_ID=
JOBSEARCHOS_NOTION_DATA_SOURCE_ID=

# The companion database that resolves the tracker's Company relation to a
# display name (e.g. a "Master Companies" database).
JOBSEARCHOS_NOTION_COMPANY_SOURCE_ID=
